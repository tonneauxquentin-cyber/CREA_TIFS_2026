# Activer le moteur de réécriture
RewriteEngine on
 
# --------------------------------------------
# Fichiers ou dossiers réels (css, js, images, pdf, zip, etc.) : pas de réécriture, on les sert tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
 
# --------------------------------------------
# RÈGLES DE RÉ-ÉCRITURE
# ROUTE PROJECTS.SHOW
# PATTERN: /projects/id/slug DANS LE HREF
# URL: ?projects=show&id=x DANS LE ROUTER
RewriteRule ^projects\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\.html$ index.php?projects=show&id=$1 [L]

# ROUTE PROJECTS.DELETE
# PATTERN: /projects/delete/id/slug.html DANS LE HREF
# URL: ?projects=delete&id=x DANS LE ROUTER
RewriteRule ^projects\/delete\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\.html$ index.php?projects=delete&id=$1 [L]

# ROUTE PROJECTS.ADD.FORM
# PATTERN: /projects/add/form.html DANS LE HREF
# URL: ?projects=add&form=1 DANS LE ROUTER
RewriteRule ^projects\/add\/form\.html$ index.php?projects=add&form=1 [L]

# ROUTE PROJECTS.ADD.INSERT
# PATTERN: /projects/add/insert.html DANS LE FORM ACTION
# URL: ?projects=add&insert=1 DANS LE ROUTER
RewriteRule ^projects\/add\/insert\.html$ index.php?projects=add&insert=1 [L]

# ROUTE PROJECTS.EDIT.FORM
# PATTERN: /projects/id/slug/edit/form.html DANS LE HREF
# URL: ?projects=edit&form=1&id=x DANS LE ROUTER
RewriteRule ^projects\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\/edit\/form\.html$ index.php?projects=edit&form=1&id=$1 [L]

# ROUTE PROJECTS.EDIT.UPDATE
# PATTERN: /projects/id/slug/edit/update.html DANS LE FORM ACTION
# URL: ?projects=edit&update=1&id=x DANS LE ROUTER
RewriteRule ^projects\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\/edit\/update\.html$ index.php?projects=edit&update=1&id=$1 [L]
 
# --------------------------------------------
# FALLBACK
# Toute autre URL non prise en charge par une route ci-dessus part vers le front controller
RewriteRule ^ index.php [L]