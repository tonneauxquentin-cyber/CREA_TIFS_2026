# Activer le moteur de réécriture
RewriteEngine on
 
# --------------------------------------------
# Fichiers ou dossiers réels (css, js, images, pdf, zip, etc.) : pas de réécriture, on les sert tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
 
# --------------------------------------------
# RÈGLES DE RÉ-ÉCRITURE
# ROUTE PROJECTS.SHOW
# PATTERN: /projects/id/slug DANS LE HREF
# URL: ?projects=show&id=x DANS LE ROUTER
RewriteRule ^projects\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\.html$ index.php?projects=show&id=$1 [L]

# ROUTE PROJECTS.DELETE
# PATTERN: /projects/delete/id/slug.html DANS LE HREF
# URL: ?projects=delete&id=x DANS LE ROUTER
RewriteRule ^projects\/delete\/([1-9][0-9]*)\/[a-z0-9]([a-z0-9\-]*[a-z0-9])*\.html$ index.php?projects=delete&id=$1 [L]

 
# --------------------------------------------
# FALLBACK
# Toute autre URL non prise en charge par une route ci-dessus part vers le front controller
RewriteRule ^ index.php [L]